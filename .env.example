# Supabase connection pooler (runtime) and direct PostgreSQL endpoint (migrations).
DATABASE_URL="postgresql://konek_app:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres:adminD@DB_HOST:5432/postgres?sslmode=require"

# Generate independent random secrets; DATA_ENCRYPTION_KEY must be 32 bytes,
# encoded as 64 hex characters or base64. Keep backups in a managed secret store.
SESSION_SECRET="replace-with-at-least-32-random-characters"
DATA_ENCRYPTION_KEY="replace-with-64-hex-characters"
IP_HASH_SALT="replace-with-a-separate-random-secret"

# Public HTTPS origin used for certificate QR verification URLs.
NEXT_PUBLIC_APP_URL="https://barangay.example.gov.ph"

# S3-compatible private bucket (Supabase Storage S3 endpoint or another provider).
S3_ENDPOINT="https://your-project.storage.supabase.co/storage/v1/s3"
S3_REGION="ap-southeast-1"
S3_BUCKET="barangay-private-documents"
S3_ACCESS_KEY_ID="replace-with-storage-access-key"
S3_SECRET_ACCESS_KEY="replace-with-storage-secret-key"

# Required only by prisma/seed.cjs during first-time administrator bootstrap.
ADMIN_EMAIL="administrator@example.gov.ph"
ADMIN_INITIAL_PASSWORD="replace-with-a-unique-strong-password"
